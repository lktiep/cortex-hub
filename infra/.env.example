# Cortex Hub — Server Environment
# Copy to .env and fill in actual values

# ── Required ─────────────────────────────────
MANAGEMENT_PASSWORD=           # CLIProxy management key (required, no default).
                               # Passed to cli-proxy-api as an env var and read
                               # natively — cliproxy-config.yaml deliberately
                               # sets no secret-key, so this is the only
                               # credential for /v0/management/*.

# ── GitNexus ─────────────────────────────────
GITNEXUS_AUTH_TOKEN=           # Bearer token for eval-server (optional).
                               # eval-server refuses to listen on 0.0.0.0 without
                               # one. Leave empty and gitnexus generates a token,
                               # shares it with dashboard-api via the api-data
                               # volume, and reuses it across restarts.
DEFAULT_REPO=                  # Repo to index on first start (optional).
                               # Without it, and with no repo added via the
                               # Dashboard, gitnexus idles until one appears.

# ── Resource limits (optional) ───────────────
# OLLAMA_MEMORY_LIMIT=4G
# OLLAMA_CPUS=4                # CPU quota for ollama
# OLLAMA_THREADS=              # Threads per model; defaults to OLLAMA_CPUS.
                               # More threads than CPUs only adds throttling.
# QDRANT_MEMORY_LIMIT=2G

# ── Gemini (optional, for cloud embeddings) ──
GEMINI_API_KEY=                # Google Gemini API key

# ── Dashboard API ────────────────────────────
PORT=4000
NODE_ENV=production
DATABASE_PATH=/app/data/cortex.db

# ── Public URLs (set when the hub sits behind a domain) ──
EXTERNAL_MCP_URL=              # MCP address agents connect to, e.g.
                               # https://mcp.example.com (/mcp is appended).
                               # Empty: the dashboard shows the https address the
                               # first agent connected through (e.g. via the
                               # tunnel), else http://<host>:8318/mcp on
                               # localhost/LAN, else a "not configured" hint.
# EXTERNAL_API_URL=            # Same, for the API link on Settings.
# EXTERNAL_LLM_PROXY_URL=      # Same, for the LLM proxy link on Settings.

# ── Indexing ─────────────────────────────────
# BRANCH_RETENTION_DAYS=14     # Drop a branch's vectors after this many days
                               # without an index, or once it is merged into
                               # the default branch or deleted on the remote.
                               # Never the default branch. 0 = keep all.

# ── Sessions ─────────────────────────────────
# SESSION_IDLE_HOURS=72         # Mark an active session expired after this many
                               # hours without a tool call. 0 = never.

# ── LLM (chat model) ─────────────────────────
# Embeddings (search, indexing, memory recall) never need a chat model. Three
# features do: memory fact extraction, recipe capture and knowledge self-repair.
# Without a routed chat model they are off; Settings → LLM can turn them off too.
# CORTEX_LLM=                  # off: never call a chat model, whatever Settings
                               # says. on: ignore the Settings switch. Empty:
                               # follow Settings.
# MEMORY_LLM=                  # off: store memories as written (near-duplicates
                               # skipped) instead of extracting facts.
# RECIPE_CAPTURE=              # off: no recipes from finished tasks/sessions.
